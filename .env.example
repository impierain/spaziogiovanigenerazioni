# Copia questo file in ".env" e compila i valori (in locale).
# Su Render, questi vanno inseriti come Environment Variables dal pannello.

PORT=3000
NODE_ENV=development
SESSION_SECRET=cambia_questa_stringa_con_qualcosa_di_lungo_e_casuale

# Chiave semplice condivisa con l'ESP32 per autenticare le chiamate di sincronizzazione
ESP32_API_KEY=cambia_anche_questa

# Credenziali del database Turso (le ottieni con "turso db show <nome-db>" e
# "turso db tokens create <nome-db>" dopo aver creato il database - vedi README)
TURSO_DATABASE_URL=libsql://il-tuo-db.turso.io
TURSO_AUTH_TOKEN=

# Indirizzo pubblico del sito (senza / finale) - serve per i link nelle email
SITE_URL=https://spaziogiovanigenerazioni.onrender.com

# Chiave di Resend (https://resend.com, gratis fino a 3000 email/mese)
# per mandare l'email di "imposta la tua password" ai nuovi soci.
# Senza questa chiave, i soci vengono creati comunque ma l'email non parte.
RESEND_API_KEY=
EMAIL_MITTENTE=Spazio Giovani <onboarding@resend.dev>
